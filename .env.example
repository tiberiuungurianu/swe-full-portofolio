# Required to list pending notes and approve/reject them.
# Generate a long random string. Never commit the real value.
GUESTBOOK_MODERATION_SECRET=

# Optional: override the guestbook JSON path (defaults to data/guestbook.json).
# GUESTBOOK_DATA_PATH=

# Google sign-in for the guestbook. The public note stores the first name only.
# Create an OAuth client (Web application) and add the redirect URI for the
# host you open locally. The dev server is http://localhost:4327
# http://localhost:4327/api/auth/google/callback
# http://127.0.0.1:4327/api/auth/google/callback
# Generate AUTH_SECRET with: openssl rand -base64 32
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional override for the public origin. Leave unset to use the deploy variant:
# development http://localhost:4327, production https://tiberiuungurianu.com
# AUTH_URL=https://tiberiuungurianu.com
